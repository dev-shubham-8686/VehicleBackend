<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="StackExchange.Redis" Version="3.3.1" />
    <PackageReference Include="Testcontainers.Kafka" Version="4.15.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="Testcontainers.Redis" Version="4.15.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- These are heavyweight Testcontainers-backed tests, each class spinning up its
         own Kafka/Postgres/Redis/VerneMQ containers — too much concurrent load on the
         Docker daemon to parallelize safely, so collections run serially (see
         docs/ARCHITECTURE.md#testing). -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shared\Cvp.Contracts\Cvp.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Shared\Cvp.Common\Cvp.Common.csproj" />
    <!-- Each service is a top-level-statement Program, all named `Program` in the
         global namespace; aliasing avoids CS0433 when a test file needs more than one. -->
    <ProjectReference Include="..\..\src\Services\DeviceGateway\DeviceGateway.csproj" Aliases="DeviceGatewayAssembly" />
    <ProjectReference Include="..\..\src\Services\TelemetryProcessor\TelemetryProcessor.csproj" Aliases="TelemetryProcessorAssembly" />
    <ProjectReference Include="..\..\src\Services\CommandService\CommandService.csproj" Aliases="CommandServiceAssembly" />
    <ProjectReference Include="..\..\src\Services\VehicleShadow\VehicleShadow.csproj" Aliases="VehicleShadowAssembly" />
    <ProjectReference Include="..\..\src\Services\IdentityService\IdentityService.csproj" Aliases="IdentityServiceAssembly" />
  </ItemGroup>

</Project>